{
  "name": "gold-recycling-h5",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "黄金回收 H5 原型（微信内置浏览器 / PC 浏览器演示）",
  "engines": {
    "node": ">=20.19 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "bash scripts/build.sh",
    "preview": "vite preview --port 8012",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "ui:check": "node scripts/check-ui.mjs",
    "routes:check": "node scripts/check-routes.mjs",
    "verify": "npm run typecheck && npm run lint && npm run ui:check && npm run routes:check && npm run build",
    "verify:full": "npm run verify && npm run visual:check",
    "visual:update": "node scripts/visual.mjs --update",
    "visual:check": "node scripts/visual.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "browserslist": [
    "ios_saf >= 13.4",
    "safari >= 13",
    "chrome >= 79"
  ],
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "0.577.0",
    "marked": "^18.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@csstools/postcss-cascade-layers": "^5.0.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.65.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.2.0",
    "typescript": "~5.9",
    "typescript-eslint": "^8.26.0",
    "vite": "^7.1.7"
  }
}
